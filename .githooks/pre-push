#!/bin/sh
set -eu

# Pre-push guard: local verification, then optional Qlty and CodeRabbit.
# Enable: git config core.hooksPath .githooks (pnpm install does this).
# Tools: https://qlty.sh · brew install coderabbit · coderabbit auth login
# Bypass once: git push --no-verify

GATE_SEVERITY="major"
MIN_CODERABBIT_VERSION="0.9.1"
NULL_OID="0000000000000000000000000000000000000000"
BASE_REF="${CODERABBIT_BASE_REF:-origin/main}"
input=$(cat)

echo "pre-push: pnpm verify"
pnpm verify

if command -v qlty >/dev/null 2>&1 && [ -f .qlty/qlty.toml ]; then
  report=$(mktemp) || exit 1
  status=0
  printf '%s\n' "$input" | qlty check \
    --trigger pre-push \
    --upstream-from-pre-push \
    --no-formatters \
    --skip-errored-plugins \
    --no-upgrade-check >"$report" 2>&1 || status=$?
  grep -v '^Tap enter to skip\.\.\.$' "$report" || true
  rm -f "$report"
  if [ "$status" -ne 0 ]; then
    echo "pre-push: blocked by Qlty. Fix findings or use --no-verify."
    exit 1
  fi
else
  echo "pre-push: qlty missing or .qlty/qlty.toml absent; skipping."
fi

if ! command -v coderabbit >/dev/null 2>&1; then
  echo "pre-push: coderabbit missing; skipping."
  exit 0
fi
if ! coderabbit auth status >/dev/null 2>&1; then
  echo "pre-push: coderabbit not authenticated; skipping."
  exit 0
fi

version=$(coderabbit --version 2>/dev/null | tr -d '[:space:]' | sed 's/^v//')
if [ -z "$version" ] || \
  [ "$(printf '%s\n%s\n' "$version" "$MIN_CODERABBIT_VERSION" | sort -V | head -n 1)" != "$MIN_CODERABBIT_VERSION" ]; then
  echo "pre-push: coderabbit $version is older than $MIN_CODERABBIT_VERSION; skipping."
  exit 0
fi

if ! git rev-parse --verify "$BASE_REF" >/dev/null 2>&1; then
  if git rev-parse --verify main >/dev/null 2>&1; then
    BASE_REF=main
  else
    echo "pre-push: no review base ref; skipping CodeRabbit."
    exit 0
  fi
fi

head_sha=$(git rev-parse HEAD)
needs_review=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" = "$NULL_OID" ] && continue
  if [ "$local_sha" != "$head_sha" ]; then
    echo "pre-push: CodeRabbit reviews HEAD only; check out $local_ref and retry."
    exit 1
  fi
  if [ "$(git rev-parse "$BASE_REF")" != "$local_sha" ]; then
    needs_review=1
  fi
done <<EOF
$input
EOF

if [ "$needs_review" -eq 0 ]; then
  echo "pre-push: no commits ahead of $BASE_REF; skipping CodeRabbit."
  exit 0
fi

echo "pre-push: coderabbit review --base $BASE_REF --gate $GATE_SEVERITY"
status=0
coderabbit review --committed --base "$BASE_REF" --gate "$GATE_SEVERITY" || status=$?
if [ "$status" -eq 2 ]; then
  echo "pre-push: blocked by CodeRabbit ($GATE_SEVERITY or higher). Fix or use --no-verify."
  exit 1
fi
if [ "$status" -ne 0 ]; then
  echo "pre-push: CodeRabbit review failed. Fix or use --no-verify."
  exit 1
fi
